# WxPush Nginx 配置示例
#
# 后端内置静态文件服务，Nginx 只需一行 proxy_pass 即可。
# 无需配置 try_files、正则匹配 .send、静态资源规则等。
#
# 用法：
#   1) sudo cp deploy/nginx.conf.example /etc/nginx/conf.d/wxpush.conf
#   2) 修改 server_name 与 SSL 证书路径
#   3) sudo nginx -t && sudo nginx -s reload

# 限流：保护登录与推送接口
limit_req_zone $binary_remote_addr zone=wxpush_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=wxpush_push:10m rate=120r/m;

server {
    listen 80;
    server_name wxpush.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name wxpush.example.com;

    # SSL 证书（按实际路径修改）
    ssl_certificate     /etc/letsencrypt/live/wxpush.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wxpush.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # 安全响应头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 客户端请求体上限（支持图片推送）
    client_max_body_size 25m;

    # 登录接口独立限流
    location = /api/admin/auth/login {
        limit_req zone=wxpush_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8401;
    }

    # 推送接口独立限流
    location ~ ^/[A-Za-z0-9_-]+\.send$ {
        limit_req zone=wxpush_push burst=60 nodelay;
        proxy_pass http://127.0.0.1:8401;
    }

    location = /api/v1/push {
        limit_req zone=wxpush_push burst=60 nodelay;
        proxy_pass http://127.0.0.1:8401;
    }

    location = /api/v2/openapi/messages/send {
        limit_req zone=wxpush_push burst=60 nodelay;
        proxy_pass http://127.0.0.1:8401;
    }

    # 所有请求反代到后端
    # 后端自动处理：静态文件 / SPA 路由 / API / 推送接口 / 企业微信验证
    location / {
        proxy_pass http://127.0.0.1:8401;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
