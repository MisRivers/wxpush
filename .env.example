# ====== WxPush 配置文件 ======
# 复制本文件为 .env 并填写真实值

# ---- 主密钥（用于加密 DB 中的 corp_secret / webhook_key / access_token 等）----
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 长度：base64 编码后 44 字符，解码后 32 字节
MASTER_KEY=

# ---- JWT 签名密钥（管理后台登录态签名用，与 MASTER_KEY 独立）----
# 生成命令：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# 长度：≥ 32 字节随机
JWT_SECRET=

# ---- 服务监听 ----
PORT=8401
HOST=127.0.0.1

# ---- 数据库 ----
DB_PATH=./data/push.db

# ---- 请求限制 ----
# Fastify body limit（字节），20MB 兼容大图片 base64 上传
BODY_LIMIT=20971520

# ---- 日志 ----
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
NODE_ENV=production

# ---- Cloudflare Turnstile（可选，留空表示不启用）----
# 获取地址：https://dash.cloudflare.com → Turnstile
# 留空时登录不启用人机验证；也可在管理后台「系统设置」中配置
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- 前端静态文件目录（可选）----
# 用于写入企业微信可信域名验证文件（WW_verify_*.txt），Nginx try_files 自动服务
# 默认 ./web/dist，通常无需修改
# STATIC_DIR=./web/dist
